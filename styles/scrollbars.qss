/*==========================================================
    Scrollbars
==========================================================*/

QScrollBar:vertical {

    background: transparent;

    width: 10px;

}


QScrollBar::handle:vertical {

    background: #535964;

    border-radius: 5px;

}


QScrollBar::handle:vertical:hover {

    background: #63B8FF;

}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;

}


