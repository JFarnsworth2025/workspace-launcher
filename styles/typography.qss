/*==========================================================
    Typography
==========================================================*/

/*==========================================================
    Workspace Card
==========================================================*/

#workspaceTitle {

    font-size: 16px;

    font-weight: 600;

    color: #F4F6F8;

    min-height: 24px;

}

#workspaceSubtitle {

    font-size: 12px;

    color: #C2C8D0;

}

#workspaceApplication {

    font-size: 14px;

    color: #E2E8F0;

}

/*==========================================================
    Verse Card
==========================================================*/

#verseTitle {

    font-size: 15px;
    font-weight: 700;

}

#verseReference {

    font-size: 11px;
    font-weight: 600;
    color: #3EA6FF;

}

#verseText {

    font-size: 11px;
    color: #F4F6F8;

}


/*==========================================================
    Quote Card
==========================================================*/

#quoteTitle {

    font-size: 15px;
    font-weight: 700;

}

#quoteAuthor {

    font-size: 11px;
    color: #3EA6FF;

}

#quoteText {

    font-size: 11px;
    color: #F4F6F8;

}


/*==========================================================
    Current Workspace
==========================================================*/

#currentWorkspace {

    font-size: 13px;
    font-weight: 600;

}



