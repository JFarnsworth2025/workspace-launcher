/*==========================================================
    Inputs
==========================================================*/

QLineEdit,
QComboBox,
QSpinBox {

    background-color: #33363D;

    color: white;

    border: 1px solid #535964;

    border-radius: 8px;

    padding: 6px;

}


QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {

    border: 1px solid #3EA6FF;

}


