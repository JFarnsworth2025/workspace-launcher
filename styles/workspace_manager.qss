/*==========================================================
    Workspace Manager
==========================================================*/

#workspaceManagerWindow {
    background-color: #202225;
}

#workspaceManagerTitle {
    color: #F4F6F8;
    font-size: 24px;
    font-weight: 700;
}

#workspaceManagerSubtitle {
    color: #9CA3AF;
    font-size: 12px;
}

#workspaceManagerList,
#workspaceManagerApplications {
    background-color: #2B2D31;
    color: #F4F6F8;
    border: 1px solid #434852;
    border-radius: 10px;
    outline: none;
    padding: 5px;
}

#workspaceManagerList::item {
    min-height: 24px;
    border-radius: 7px;
    padding: 7px 10px;
    margin: 0px;
}

#workspaceManagerList::item:hover {
    background-color: #3B4048;
}

#workspaceManagerList::item:selected {
    background-color: #404650;
    color: #F4F6F8;
}

#workspaceManagerDetails {
    background-color: #2B2D31;
    border: 1px solid #434852;
    border-radius: 10px;
}

#workspaceManagerName {
    color: #3EA6FF;
    font-size: 17px;
    font-weight: 700;
}

#workspaceManagerApplications QHeaderView::section {
    background-color: #33363D;
    color: #C2C8D0;
    border: none;
    border-bottom: 1px solid #535964;
    padding: 9px;
    font-weight: 600;
}

#workspaceManagerApplications::item {
    min-height: 22px;
    padding: 5px 7px;
    border-bottom: 1px solid #3B4048;
}

/*==========================================================
    Workspace Editor
==========================================================*/

#workspaceEditor {
    background-color: #202225;
}

#workspaceEditorTitle {
    color: #F4F6F8;
    font-size: 22px;
    font-weight: 700;
}

#workspaceEditorSubtitle {
    color: #9CA3AF;
    font-size: 12px;
}

#workspaceEditorSectionTitle {
    color: #C2C8D0;
    font-size: 13px;
    font-weight: 600;
}

#workspaceEditorApplications {
    background-color: #2B2D31;
    color: #F4F6F8;
    border: 1px solid #434852;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

/*==========================================================
    Application Editor
==========================================================*/

#applicationEditor {
    background-color: #202225;
}

#applicationEditorTitle {
    color: #F4F6F8;
    font-size: 22px;
    font-weight: 700;
}

#applicationEditorSubtitle {
    color: #9CA3AF;
    font-size: 12px;
}



