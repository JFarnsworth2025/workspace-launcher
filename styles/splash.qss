/*==========================================================*
 * Startup Splash
 *==========================================================*/

#splashWindow {
    background-color: #202225;
    border: 1px solid #535964;
    border-radius: 22px;
}

#splashLogo {
    background: transparent;
}

#splashStatus {
    color: #C2C8D0;
    font-size: 14px;
    font-weight: 600;
}

#splashProgress {
    min-height: 24px;
    max-height: 24px;
    color: #F4F6F8;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    background-color: #2B2D31;
    border: 1px solid #434852;
    border-radius: 12px;
}

#splashProgress::chunk {
    background-color: #3EA6FF;
    border-radius: 11px;
}



